{
  "name": "mta-attendance-bot",
  "version": "1.0.0",
  "description": "Bot de Discord MTA para registrar asistencias de practicantes en Google Sheets",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "deploy-commands": "tsx src/deploy-commands.ts",
    "seed:horarios": "tsx src/scripts/seedHorarios.ts",
    "format:sheets": "tsx src/scripts/formatSheets.ts",
    "setup:practicantes-clases": "tsx src/scripts/setupPracticantesYClases.ts",
    "test": "vitest run"
  },
  "keywords": [
    "discord",
    "discord-bot",
    "attendance",
    "google-sheets",
    "typescript"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "discord.js": "^14.16.3",
    "dotenv": "^16.4.7",
    "googleapis": "^144.0.0",
    "node-cron": "^4.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/node-cron": "^3.0.11",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.11"
  }
}
