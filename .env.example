# Discord
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# Canal donde vive el panel de botones de asistencia (#asistencias)
ATTENDANCE_CHANNEL_ID=
# Opcional en desarrollo: registro instantáneo de comandos en un servidor
DISCORD_GUILD_ID=
# Rol de Discord con permisos de admin (consultar horas de otros, /asistencia recargar)
ADMIN_ROLE_ID=

# Google Sheets — respaldo de emergencia (el bot usa MySQL como principal)
GOOGLE_SHEETS_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Pegar la clave privada entre comillas, con \n para los saltos de línea
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# El bot es independiente (Discord + MySQL). El ERP NO es requerido para marcar.
# El ERP solo llama a la API HTTP de este bot.

# URL pública de Railway (ERP). Railway asigna PORT; no lo definas en el panel.
PUBLIC_API_URL=https://mtaasistenciabot-production.up.railway.app
# Clave que el ERP envía en x-api-key / Authorization: Bearer
BOT_API_KEY=

# Zona horaria (ej: America/Lima, America/Mexico_City)
TIMEZONE=America/Lima

# MySQL Hostinger — almacenamiento principal (obligatorio)
MYSQL_HOST=srv1069.hstgr.io
MYSQL_PORT=3306
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_SSL=true
