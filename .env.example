# Discord
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# Canal donde vive el panel de botones de asistencia (#asistencias)
ATTENDANCE_CHANNEL_ID=
# Opcional en desarrollo: registro instantáneo de comandos en un servidor
DISCORD_GUILD_ID=
# Rol de Discord con permisos de admin (consultar horas de otros, /asistencia recargar)
ADMIN_ROLE_ID=

# Google Sheets — respaldo de emergencia (el bot usa MySQL como principal)
GOOGLE_SHEETS_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Pegar la clave privada entre comillas, con \n para los saltos de línea
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Dashboard / ERP (opcional: si faltan, el bot no sincroniza marcaciones hacia el ERP)
# URL base del backend, sin barra final (ej: https://erp.mta.pe)
DASHBOARD_API_URL=
# Clave que el BOT envía al ERP al marcar entrada/salida (header x-api-key)
ATTENDANCE_BOT_API_KEY=

# API HTTP que el ERP llama hacia este bot (Railway asigna PORT)
PORT=3000
# Clave que el ERP debe enviar al bot. Si no está, se reutiliza ATTENDANCE_BOT_API_KEY
BOT_API_KEY=

# Zona horaria (ej: America/Lima, America/Mexico_City)
TIMEZONE=America/Lima

# MySQL Hostinger — almacenamiento principal (obligatorio)
MYSQL_HOST=srv1069.hstgr.io
MYSQL_PORT=3306
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_SSL=true
